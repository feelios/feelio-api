# 배포 서버에서 이 파일을 .env 로 복사한 뒤 실제 값을 채워 사용한다.
#   cp .env.example .env
#   docker run --env-file .env -p 8080:8080 feelio-api
#
# .env 는 절대 커밋하지 않는다 (.gitignore / .dockerignore 로 차단되어 있다).
# 로컬 개발은 기존처럼 src/main/resources/application-secret.yaml 을 그대로 쓰면 된다.
# 환경변수가 설정 파일보다 우선순위가 높으므로, 도커에서는 아래 값이 적용된다.

# --- DB ---
DB_URL=jdbc:mysql://HOST:3306/DBNAME
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 프론트엔드 주소 ---
# prod 프로필이 기본값 없이 참조한다. 비면 기동에 실패한다.
CLIENT_URL=https://example.store

# --- OpenAI ---
# application.yaml 의 openai.key 가 기본값 없이 참조한다. 비면 기동에 실패한다.
OPENAI_KEY=
# 파인튜닝 모델 ID (예: ft:gpt-4o-mini-2024-07-18:org::xxxxxxx)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# --- 인사이트 생성 (계약 §9) ---
# rule = 규칙기반(기본, 호출 없음) / gpt = OpenAI 호출
INSIGHT_PROVIDER=rule
# 이번 달 인사이트 재생성 주기(시간). 지난 달 이전은 영구 캐시.
INSIGHT_TTL_HOURS=6
