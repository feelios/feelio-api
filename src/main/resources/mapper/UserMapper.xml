<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- user 도메인 SQL. namespace/id 는 UserMapper 인터페이스와 정확히 일치. #{} 만 사용. -->
<mapper namespace="com.korit.feelioapi.domain.user.mapper.UserMapper">

    <!-- 본인 정보 조회(PK). -->
    <select id="findUserById" resultType="com.korit.feelioapi.domain.user.entity.User">
        SELECT user_id, nickname, email, profile_image_url, total_asset, onboarding_done,
               theme_mode, aurora_theme, status, fcm_token, created_at, updated_at
        FROM users
        WHERE user_id = #{userId}
    </select>

    <!-- user 객체의 provider: 복수 연동 대비 최신 connected_at 1건. -->
    <select id="findProviderByUserId" resultType="string">
        SELECT provider
        FROM social_accounts
        WHERE user_id = #{userId}
        ORDER BY connected_at DESC
        LIMIT 1
    </select>

    <!-- 닉네임 수정: 본인 행만. -->
    <update id="updateNickname">
        UPDATE users
        SET nickname = #{nickname}
        WHERE user_id = #{userId}
    </update>

    <!-- 온보딩 완료: 본인 행의 플래그만 on. -->
    <update id="markOnboardingDone">
        UPDATE users
        SET onboarding_done = 1,
            total_asset = #{totalAsset}
        WHERE user_id = #{userId}
    </update>

    <!--
      거래가 자산에 준 변화량(수입 − 지출). 거래가 없으면 0.
      users.total_asset(온보딩 초기값)에 이 값을 더한 것이 현재 총자산이다 (#200).
      저축은 type=EXPENSE 라 자연히 차감된다 — 홈 카드가 '목표와 별개인 자산'을 뜻하고
      목표 적립액은 따로 표시되므로, 차감해야 이중계산이 되지 않는다.
    -->
    <select id="sumTransactionEffect" resultType="long">
        SELECT COALESCE(SUM(CASE WHEN type = 'INCOME' THEN amount ELSE -amount END), 0)
        FROM transactions
        WHERE user_id = #{userId}
    </select>

    <!-- 설정 부분 수정: 전송된(null 아닌) 컬럼만 갱신. -->
    <update id="updateSettings">
        UPDATE users
        <set>
            <if test="themeMode != null">theme_mode = #{themeMode},</if>
            <if test="auroraTheme != null">aurora_theme = #{auroraTheme},</if>
        </set>
        WHERE user_id = #{userId}
    </update>

    <!-- FCM 토큰 저장 -->
    <update id="updateFcmToken">
        UPDATE users
        SET fcm_token = #{fcmToken}
        WHERE user_id = #{userId}
    </update>

    <!-- ===== 회원탈퇴(A3-4) ===== -->
    <!-- users 는 행을 남기고 상태만 WITHDRAWN 으로(재로그인 정책은 auth 소관·미확정). -->
    <update id="markWithdrawn">
        UPDATE users SET status = 'WITHDRAWN' WHERE user_id = #{userId}
    </update>

    <!-- 하위 데이터 hard delete (FK 미사용이라 직접 삭제). terms_agreements 는 보존. -->
    <delete id="deleteSocialAccountsByUserId">
        DELETE FROM social_accounts WHERE user_id = #{userId}
    </delete>
    <delete id="deleteRefreshTokensByUserId">
        DELETE FROM refresh_tokens WHERE user_id = #{userId}
    </delete>
    <delete id="deleteNotificationSettingsByUserId">
        DELETE FROM notification_settings WHERE user_id = #{userId}
    </delete>
    <delete id="deleteTransactionsByUserId">
        DELETE FROM transactions WHERE user_id = #{userId}
    </delete>
    <delete id="deleteGoalsByUserId">
        DELETE FROM goals WHERE user_id = #{userId}
    </delete>
    <delete id="deleteMonthlySummariesByUserId">
        DELETE FROM monthly_summaries WHERE user_id = #{userId}
    </delete>
    <delete id="deleteAiInsightsByUserId">
        DELETE FROM ai_insights WHERE user_id = #{userId}
    </delete>

</mapper>
